{
  "openapi": "3.0.3",
  "info": {
    "title": "Shoes Store API Specification",
    "description": "Tài liệu mô tả toàn bộ API của dự án bán giày (Node.js + Express.js + MySQL).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Server"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Đăng ký tài khoản mới",
        "description": "Tạo tài khoản mới, sau khi tạo sẽ tự động gửi mã OTP 6 số về email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "full_name",
                  "email",
                  "password"
                ],
                "properties": {
                  "full_name": {
                    "type": "string",
                    "example": "Nguyễn Văn A",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "nguyenvana@gmail.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "Password123",
                    "description": "Phải chứa ít nhất 8 ký tự, 1 chữ hoa, 1 chữ thường và 1 số."
                  },
                  "phone": {
                    "type": "string",
                    "example": 987654321,
                    "pattern": "^0\\d{9}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đăng ký thành công, vui lòng kiểm tra OTP trong email."
          },
          "400": {
            "description": "Validate dữ liệu thất bại hoặc email đã tồn tại."
          }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Xác minh mã OTP",
        "description": "Xác minh tài khoản bằng mã OTP 6 số được gửi qua email.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "otp"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "nguyenvana@gmail.com"
                  },
                  "otp": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Xác minh tài khoản thành công."
          },
          "400": {
            "description": "OTP không chính xác hoặc đã hết hạn."
          }
        }
      }
    },
    "/api/auth/resend-otp": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Gửi lại mã OTP",
        "description": "Yêu cầu gửi lại mã OTP mới đến email nếu mã cũ hết hạn.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "nguyenvana@gmail.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đã gửi lại OTP mới thành công."
          },
          "400": {
            "description": "Email chưa đăng ký hoặc có lỗi xảy ra."
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Đăng nhập bằng email & password",
        "description": "Kiểm tra thông tin đăng nhập và trả về mã JWT Token cùng thông tin user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@gmail.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "AdminPassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập thành công, trả về token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Đăng nhập thành công"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        },
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 1
                            },
                            "full_name": {
                              "type": "string",
                              "example": "Admin Store"
                            },
                            "email": {
                              "type": "string",
                              "example": "admin@gmail.com"
                            },
                            "role": {
                              "type": "string",
                              "example": "admin"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sai mật khẩu hoặc tài khoản chưa kích hoạt."
          }
        }
      }
    },
    "/api/auth/google": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Đăng nhập bằng tài khoản Google",
        "description": "Xác thực ID Token từ Google Client (OAuth2) và trả về JWT Token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "credential"
                ],
                "properties": {
                  "credential": {
                    "type": "string",
                    "example": "Google_Id_Token_String_Here"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đăng nhập Google thành công."
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Lấy thông tin cá nhân hiện tại",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy thông tin thành công."
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Cập nhật thông tin cá nhân",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string",
                    "example": "Nguyễn Văn B"
                  },
                  "phone": {
                    "type": "string",
                    "example": 912345678
                  },
                  "address": {
                    "type": "string",
                    "example": "123 Đường ABC, Quận 1, TP. HCM"
                  },
                  "gender": {
                    "type": "string",
                    "enum": [
                      "nam",
                      "nu",
                      "khac"
                    ],
                    "example": "nam"
                  },
                  "dob": {
                    "type": "string",
                    "format": "date",
                    "example": "1995-10-15"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công."
          }
        }
      }
    },
    "/api/profile/change-password": {
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Đổi mật khẩu",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "old_password",
                  "new_password"
                ],
                "properties": {
                  "old_password": {
                    "type": "string",
                    "example": "Password123"
                  },
                  "new_password": {
                    "type": "string",
                    "example": "NewPassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Đổi mật khẩu thành công."
          },
          "400": {
            "description": "Mật khẩu cũ không đúng hoặc mật khẩu mới trùng mật khẩu cũ."
          }
        }
      }
    },
    "/api/profile/avatar": {
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Cập nhật ảnh đại diện (Avatar)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "avatar"
                ],
                "properties": {
                  "avatar": {
                    "type": "string",
                    "format": "binary",
                    "description": "File ảnh đại diện (JPG, PNG, WEBP tối đa 2MB)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật ảnh đại diện thành công."
          }
        }
      }
    },
    "/api/admin/categories": {
      "get": {
        "tags": [
          "Admin Category"
        ],
        "summary": "Lấy cây danh mục 2 tầng (Cha -> Con)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy danh sách thành công."
          }
        }
      },
      "post": {
        "tags": [
          "Admin Category"
        ],
        "summary": "Tạo danh mục mới",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Giày Nike Nam"
                  },
                  "parent_id": {
                    "type": "string",
                    "example": "1",
                    "description": "Trỏ tới ID danh mục cha. Trống hoặc \"null\" nếu là danh mục cha."
                  },
                  "sort_order": {
                    "type": "string",
                    "example": "1",
                    "description": "Thứ tự hiển thị."
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Ảnh danh mục (JPG, PNG, WEBP tối đa 2MB)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo danh mục thành công."
          }
        }
      }
    },
    "/api/admin/categories/{id}": {
      "put": {
        "tags": [
          "Admin Category"
        ],
        "summary": "Cập nhật danh mục",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 3
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Giày Nike Nam Cận Cao Cấp"
                  },
                  "parent_id": {
                    "type": "string",
                    "example": "1"
                  },
                  "sort_order": {
                    "type": "string",
                    "example": "5"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Ảnh mới cần cập nhật."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công."
          }
        }
      }
    },
    "/api/admin/categories/{id}/toggle-status": {
      "put": {
        "tags": [
          "Admin Category"
        ],
        "summary": "Ẩn/Hiện danh mục (Toggle is_active)",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Thay đổi trạng thái thành công. Ẩn cha sẽ tự ẩn con."
          }
        }
      }
    },
    "/api/admin/categories/reorder": {
      "put": {
        "tags": [
          "Admin Category"
        ],
        "summary": "Sắp xếp lại danh mục",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "sort_order"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1
                        },
                        "sort_order": {
                          "type": "integer",
                          "example": 10
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sắp xếp lại thành công."
          }
        }
      }
    },
    "/api/admin/brands": {
      "get": {
        "tags": [
          "Admin Brand"
        ],
        "summary": "Lấy toàn bộ thương hiệu kèm số sản phẩm",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy danh sách thành công."
          }
        }
      },
      "post": {
        "tags": [
          "Admin Brand"
        ],
        "summary": "Tạo thương hiệu mới",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Nike"
                  },
                  "description": {
                    "type": "string",
                    "example": "Thương hiệu thể thao nổi tiếng của Mỹ."
                  },
                  "logo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Ảnh Logo thương hiệu (tối đa 2MB)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tạo thương hiệu thành công."
          }
        }
      }
    },
    "/api/admin/brands/{id}": {
      "put": {
        "tags": [
          "Admin Brand"
        ],
        "summary": "Cập nhật thương hiệu",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Nike Store"
                  },
                  "description": {
                    "type": "string",
                    "example": "Mô tả mới cập nhật."
                  },
                  "logo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Ảnh Logo mới cập nhật."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cập nhật thành công."
          }
        }
      }
    },
    "/api/admin/brands/{id}/toggle-status": {
      "put": {
        "tags": [
          "Admin Brand"
        ],
        "summary": "Ẩn/Hiện thương hiệu",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Thay đổi trạng thái thương hiệu thành công."
          }
        }
      }
    },
    "/api/addresses": {
      "get": {
        "tags": [
          "Addresses"
        ],
        "summary": "Lấy danh sách tất cả địa chỉ của người dùng",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lấy danh sách địa chỉ thành công.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Lấy danh sách địa chỉ thành công"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 1
                          },
                          "user_id": {
                            "type": "integer",
                            "example": 2
                          },
                          "receiver_name": {
                            "type": "string",
                            "example": "Nguyễn Văn A"
                          },
                          "phone": {
                            "type": "string",
                            "example": "0987654321"
                          },
                          "address_line": {
                            "type": "string",
                            "example": "123 Đường ABC"
                          },
                          "ward": {
                            "type": "string",
                            "example": "Phường 1"
                          },
                          "district": {
                            "type": "string",
                            "example": "Quận 1"
                          },
                          "city": {
                            "type": "string",
                            "example": "TP. Hồ Chí Minh"
                          },
                          "is_default": {
                            "type": "boolean",
                            "example": true
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Addresses"
        ],
        "summary": "Thêm một địa chỉ mới",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "receiver_name",
                  "phone",
                  "address_line",
                  "district",
                  "city"
                ],
                "properties": {
                  "receiver_name": {
                    "type": "string",
                    "example": "Nguyễn Văn A",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "phone": {
                    "type": "string",
                    "example": "0987654321",
                    "pattern": "^0\\d{9}$"
                  },
                  "address_line": {
                    "type": "string",
                    "example": "123 Đường ABC",
                    "minLength": 5,
                    "maxLength": 255
                  },
                  "ward": {
                    "type": "string",
                    "example": "Phường 1",
                    "maxLength": 100,
                    "nullable": true
                  },
                  "district": {
                    "type": "string",
                    "example": "Quận 1",
                    "maxLength": 100
                  },
                  "city": {
                    "type": "string",
                    "example": "TP. Hồ Chí Minh",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Thêm địa chỉ thành công.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Thêm địa chỉ thành công"
                    },
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/addresses/{id}": {
      "put": {
        "tags": [
          "Addresses"
        ],
        "summary": "Cập nhật địa chỉ",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "receiver_name": {
                    "type": "string",
                    "example": "Nguyễn Văn B",
